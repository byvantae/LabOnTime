rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'subjects', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 1
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() > 0
        && request.resource.data.subjects.size() <= 30
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(['date','lab','start_time','teacher','subject','createdBy','createdAt'])
        && request.resource.data.lab in ['Science Lab','Computer Lab']
        && request.resource.data.date is string
        && request.resource.data.start_time is string
        && request.resource.data.teacher is string
        && request.resource.data.subject is string
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName == request.resource.data.teacher
        && request.resource.data.subject in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.subjects;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }
  }
}
